{
  "extends": "@tsconfig/svelte/tsconfig.json",

  "include": ["src/**/*"],
  "exclude": ["node_modules/*", "src/testUtils/*"],
  "compilerOptions": {
    "types": ["node", "svelte", "jest"],
    "baseUrl": ".",
    "paths": {
      "src": ["src/*"]
    },
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true
  }
}
