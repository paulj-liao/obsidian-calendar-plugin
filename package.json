{
  "name": "calendar",
  "version": "1.5.10",
  "description": "Calendar view of your daily notes",
  "author": "liamcain",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "lint": "eslint . --ext .ts",
    "typecheck": "svelte-check",
    "build": "rollup -c",
    "prebuild": "eslint . --ext .ts --max-warnings 0 || true",
    "test": "jest --passWithNoTests",
    "test:watch": "yarn test -- --watch"
  },
  "dependencies": {
    "obsidian": "obsidianmd/obsidian-api#master",
    "obsidian-calendar-ui": "0.4.0",
    "obsidian-daily-notes-interface": "0.9.4",
    "svelte": "3.59.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "28.0.1",
    "@rollup/plugin-node-resolve": "15.3.0",
    "@rollup/plugin-typescript": "12.1.1",
    "@tsconfig/svelte": "5.0.4",
    "@types/jest": "29.5.14",
    "@types/moment": "2.13.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "moment": "2.30.1",
    "rollup": "4.27.4",
    "rollup-plugin-svelte": "7.2.2",
    "svelte-check": "4.0.8",
    "svelte-jester": "5.0.0",
    "svelte-preprocess": "6.0.3",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "src/(.*)": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.svelte$": [
        "svelte-jester",
        {
          "preprocess": true
        }
      ],
      "^.+\\.ts$": ["ts-jest", {
        "tsconfig": "tsconfig.jest.json"
      }]
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "svelte"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.test.ts",
      "!src/testUtils/**"
    ]
  }
}
